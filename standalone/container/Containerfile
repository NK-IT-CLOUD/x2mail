# X2Mail standalone webmail. Build context: repository root.
#   buildah bud -f standalone/container/Containerfile -t x2mail-webmail .
# Roles: `php` (provision + php-fpm :9000) and `web` (nginx :8080).

ARG PHP_IMAGE=docker.io/library/php:8.5.10-fpm-alpine3.24

FROM docker.io/library/node:24.21.0-alpine AS assets
RUN apk add --no-cache make grep \
 && npm install -g terser@5.51.2 clean-css-cli@5.6.3
WORKDIR /src
COPY Makefile ./
COPY appinfo/info.xml appinfo/info.xml
COPY app app
COPY standalone standalone
RUN make webmail-stage

FROM ${PHP_IMAGE} AS vendor
COPY --from=docker.io/library/composer:2.10.3 /usr/bin/composer /usr/bin/composer
WORKDIR /srv/x2mail/standalone
COPY standalone/composer.json standalone/composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --optimize-autoloader --no-scripts

FROM ${PHP_IMAGE}
RUN apk add --no-cache nginx icu-libs icu-data-full libzip libpng libjpeg-turbo freetype \
 && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS icu-dev libzip-dev libpng-dev libjpeg-turbo-dev freetype-dev \
 && docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install -j"$(nproc)" intl zip gd \
 && apk del .build-deps \
 && rm -f /usr/local/etc/php-fpm.d/*.conf
COPY --from=assets /src/build/webmail/ /srv/x2mail/
COPY --from=vendor /srv/x2mail/standalone/vendor /srv/x2mail/standalone/vendor
COPY standalone/container/php-fpm.conf /usr/local/etc/php-fpm.d/x2mail.conf
COPY standalone/container/php.ini /usr/local/etc/php/conf.d/zz-x2mail.ini
COPY standalone/container/nginx.conf /etc/nginx/nginx.conf
COPY standalone/container/entrypoint.sh /usr/local/bin/x2w-entrypoint
RUN chmod 0755 /usr/local/bin/x2w-entrypoint \
 && chown -R root:root /srv/x2mail \
 && install -d -o www-data -g www-data -m 0750 /var/lib/x2mail-webmail \
 && php -r 'foreach (["ctype","intl","mbstring","zip","gd","dom","xml","openssl","sodium","curl","fileinfo","zlib"] as $e) { if (!extension_loaded($e)) { fwrite(STDERR, "missing extension: $e\n"); exit(1); } }' \
 && test ! -e /srv/x2mail/standalone/tests \
 && test -f /srv/x2mail/standalone/vendor/autoload.php
ENV X2W_CONFIG=/etc/x2mail-webmail/webmail.toml
USER www-data
RUN php-fpm -t \
 && /usr/local/bin/x2w-entrypoint web-check
EXPOSE 8080 9000
ENTRYPOINT ["/usr/local/bin/x2w-entrypoint"]
CMD ["php"]
