{
    "name": "x2mail/webmail-standalone",
    "description": "X2Mail standalone webmail front end (OIDC, no Nextcloud)",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.4.1",
        "firebase/php-jwt": "^7.2",
        "guzzlehttp/guzzle": "^8.2",
        "guzzlehttp/psr7": "^3.1",
        "internal/toml": "^1.1.3",
        "league/oauth2-client": "^2.9.1",
        "symfony/cache": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "X2Mail\\Standalone\\": "src/"
        },
        "files": [
            "../app/x2mail/v/current/app/libraries/X2Mail/Engine/HostBridge.php",
            "../app/x2mail/v/current/app/libraries/X2Mail/Engine/Host.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "X2Mail\\Standalone\\Tests\\": "tests/",
            "X2Mail\\": "../app/x2mail/v/current/app/libraries/X2Mail/",
            "Sabre\\": "../app/x2mail/v/current/app/libraries/Sabre/"
        }
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    }
}
